{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": [
      "../shared"
    ],
    "allow": [
      "Bash(make test)",
      "Bash(make test *)",
      "Bash(make lint)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/dist/**/*)",
      "Read(./**/build/**/*)"
    ]
  },
  "worktree": {
    "sparsePaths": [
      ".claude",
      "packages/api",
      "packages/shared"
    ],
    "symlinkDirectories": [
      "node_modules"
    ]
  }
}
